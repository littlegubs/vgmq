{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build", "^test"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "^test:e2e"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
