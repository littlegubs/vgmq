{
  "name": "vgmq",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=vgmq-web",
    "dev:api": "turbo run dev --filter=vgmq-api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "deploy:web": "pnpm --filter vgmq-web exec ng deploy"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  }
}
